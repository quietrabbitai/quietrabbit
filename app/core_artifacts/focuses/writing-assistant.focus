# app/core_artifacts/focuses/writing-assistant.focus
# Writing Assistant -- DISPLAY METADATA AND A LOCAL FALLBACK ONLY (items.id=903).
#
# The Writing Assistant runs from its shared.db composition (schema/shared_048.sql,
# emitted from src-tauri/focus_specs/writing-assistant.json by the focus_dev tool): a
# brief (pc-03), a draft (cb-12), the draft check (cb-06), voice (cb-13), revise (cb-14)
# and section passes, every step local. This file is read only when that row is
# missing (conductor/focus_display.rs, load_focus_definition), and it keeps two things:
#   * the display name and description, pinned equal to the focuses row by a drift test;
#   * max_routing_tier, because the loader takes the STRICTER of this file's ceiling and
#     the row's, so a tampered shared.db can narrow the Focus but never widen it.
# Its one step is local. No step here may be external: the old external draft step that
# named {user_input} is gone (constraint 7 of items.id=903, the user_input window rider).
#
# Prompt authoring rule: do not use {token_name} for any string not intended as a
# Conductor token.

id: writing-assistant
display_name: Writing Assistant
description: >
  Craft polished writing for any purpose. Your voice, your context,
  your words — refined for clarity and impact.
version: "1.0"
output_types:
  - general
max_routing_tier: 2
guides:
  - writing-voice
suggest_in_focuses: []

steps:
  draft_local:
    display_name: Writing your draft...
    task_type: creative_writing
    routing_tier: 1
    step_type: generate
    output_var: draft_output
    prompt_template: >
      Write a plain, complete draft of the document the request below asks for.
      Use only what the request says. Output only the document.

      Request: {user_input}
    options_override:
      temperature: 0.3
      num_predict: 1024
