# Force devDependencies (typescript, vite, oxlint, @types/*) to install
# even though this machine's environment/global npm config sets
# omit=dev by default, which would otherwise silently drop them.
include=dev

# items.id=418: @lobehub/icons is pinned to 1.58.0 (last version with zero
# real dependencies -- everything from 1.70.0 on hard-depends on
# @lobehub/ui, which pulls in antd, ~60MB unrelated to icon rendering).
# 1.58.0's own peerDependencies (@lobehub/ui, antd, antd-style,
# lucide-react, react-layout-kit, all ">=X" with no upper bound) are for
# features of the package this app never imports -- but npm still tries to
# auto-resolve them on a plain install, latches onto the newest
# @lobehub/ui, and that version's own peer then demands
# @lobehub/icons@^5.0.0, conflicting with our pin. legacy-peer-deps skips
# that resolution attempt instead of erroring.
legacy-peer-deps=true
